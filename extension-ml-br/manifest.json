{
  "manifest_version": 3,
  "name": "Ganancia Mercado Libre",
  "version": "1.0.0",
  "description": "Calcule seu lucro líquido na venda no Mercado Livre Brasil",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "*://*.mercadolibre.com.br/*",
    "https://sniper.gadget-nakhodki.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ganancia ML",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.mercadolivre.com.br/*", "*://*.mercadolibre.com.br/*"],
      "js": ["rates.js", "license.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}