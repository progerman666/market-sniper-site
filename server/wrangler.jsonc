{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-sniper-license",
  "main": "src/index.js",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  // Хранилище заказов и выданных ключей (идемпотентность webhook, отзыв лицензий).
  "kv_namespaces": [
    { "binding": "LICENSES", "id": "9e05744003014f6c8f25b44780a14468" }
  ],
  // Свой домен для API не используем: api.sniper.gadget-nakhodki.ru — второй уровень
  // поддомена, а бесплатный Universal SSL Cloudflare покрывает только *.gadget-nakhodki.ru.
  // Рабочий адрес — https://market-sniper-license.<account>.workers.dev (см. site/js/api.js).
  // Не секреты. Секреты задаются отдельно:
  //   npx wrangler secret put YOOKASSA_SECRET_KEY
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    "YOOKASSA_SHOP_ID": "1529556",
    "RETURN_URL": "https://sniper.gadget-nakhodki.ru/thanks.html",
    "SITE_URL": "https://sniper.gadget-nakhodki.ru",
    "MAIL_ADMIN": "goinslims@gmail.com",
    "MAIL_FROM": "Маркет-Снайпер <no-reply@sniper.gadget-nakhodki.ru>",
    "SEND_RECEIPT": "1",
    "PAY_RATE_LIMIT": "10"
  }
}

