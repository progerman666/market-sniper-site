{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.4.3",
  "description": "__MSG_appDescription__",
  "default_locale": "ru",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Маркет-Снайпер",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://localhost/*"],
      "js": ["rates.js", "license.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
